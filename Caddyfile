# Reverse proxy HTTPS du VPS (utilisé par compose.yaml) : Caddy obtient et renouvelle seul le
# certificat Let's Encrypt, redirige le HTTP vers le HTTPS et relaie tout (WebSocket compris)
# vers le nginx du front, qui sert le site et relaie /api et /ws vers atrad-back.
atrad.yayadou.net {
	encode gzip

	header {
		# Le navigateur refuse ensuite tout accès en HTTP pendant un an.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Scripts du site seulement ; styles en ligne permis (styles des composants Angular, graphiques).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' wss://atrad.yayadou.net; object-src 'self' blob:; frame-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}

	reverse_proxy atrad-front:80
}
